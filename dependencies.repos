# 上游依赖的版本锁定：vcs import src < dependencies.repos
# 这些包不入本仓库，只在 README 中记录对应版本。
repositories:
  flexiv_ros2:
    type: git
    url: https://github.com/flexivrobotics/flexiv_ros2.git
    version: humble-v1.9.3

  flexiv_description:
    type: git
    url: https://github.com/flexivrobotics/flexiv_description.git
    version: humble-v3.0

  flexiv_rdk:
    type: git
    url: https://github.com/flexivrobotics/flexiv_rdk.git
    version: v1.9.3
